# ------------------------------------------------------------------------------
# DO NOT IGNORE (keep these tracked)
# ------------------------------------------------------------------------------
# Keep example/template files
!.env.example
!config/*.example
!config/*.template

# Keep empty directories
!.gitkeep

# Keep documentation
!docs/
!*.md
!LICENSE

# Keep test fixtures
!tests/fixtures/
