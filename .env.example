# ==============================================================================
# CAN IDS HIL Project - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# ------------------------------------------------------------------------------
# Flask Application
# ------------------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=5000
DEBUG=false
LOG_LEVEL=INFO
LOG_DIRECTORY=logs

# ------------------------------------------------------------------------------
# CAN Bus Configuration
# ------------------------------------------------------------------------------
CAN_INTERFACE=can0
CAN_BITRATE=500000
CAN_CHANNEL=can0
CANDUMP_PATH=
CAN_LOG_FILE=logs/can.log

# ------------------------------------------------------------------------------
# Network / Access Point Configuration
# ------------------------------------------------------------------------------
# AP_IFACE: Dedicated Vehicle-IDS Wi-Fi AP interface (typically wlan1)
# wlan0 is left untouched for normal network connectivity
AP_IFACE=wlan1
AP_IP=10.50.0.1
AP_GATEWAY_IP=10.50.0.1
AP_NETMASK=255.255.255.0
AP_SSID=Vehicle-IDS-AP
AP_PASSWORD=change_this_password

# dnsmasq configuration
DNSMASQ_INTERFACE=wlan1
DHCP_RANGE_START=10.50.0.100
DHCP_RANGE_END=10.50.0.200
DHCP_LEASE_TIME=12h

# hostapd configuration
HOSTAPD_INTERFACE=wlan1
HOSTAPD_DRIVER=nl80211
HOSTAPD_COUNTRY=US
HOSTAPD_CHANNEL=6
HOSTAPD_HW_MODE=g

# Auto-recovery
AUTO_FIX_AP=1

# ------------------------------------------------------------------------------
# Attacker Configuration (for IDS demonstration)
# ------------------------------------------------------------------------------
ATTACKER_IP=10.214.203.60
ATTACKER_PORT=4444
# Optional: Match by MAC address instead of IP (leave empty to disable)
ATTACKER_MAC=

# ------------------------------------------------------------------------------
# Intrusion Detection System
# ------------------------------------------------------------------------------
IDS_ENABLED=true
IDS_MODEL=isolation_forest
IDS_THRESHOLD=0.0

# Detection timing
BLOCK_DELAY=18
REARM_COOLDOWN=5
POLL_INTERVAL=1.0

# Model paths
MODEL_PATH=models/can_ids_model.joblib
PREPROCESSOR_PATH=models/preprocessor.joblib
SCALER_PATH=models/scaler.joblib

# ------------------------------------------------------------------------------
# Machine Learning Configuration
# ------------------------------------------------------------------------------
# Model selection: isolation_forest, random_forest, or hybrid
ML_MODEL=isolation_forest
ML_WINDOW_SECONDS=2.0
ML_ENABLED=false

# Isolation Forest parameters
ISOLATION_CONTAMINATION=0.02
ISOLATION_N_ESTIMATORS=200
ISOLATION_RANDOM_STATE=7

# Random Forest parameters (for supervised mode)
RF_N_ESTIMATORS=100
RF_MAX_DEPTH=10
RF_RANDOM_STATE=42

# ------------------------------------------------------------------------------
# USB Attack Vector Configuration
# ------------------------------------------------------------------------------
# USB device identity for controlled demonstration
# Find with: udevadm info -a -n /dev/sdX | grep -E 'idVendor|idProduct|serial'
USB_VENDOR_ID=0000
USB_PRODUCT_ID=0000
USB_SERIAL=

# USB state tracking
USB_STATE_FILE=run/usb_state.json
USB_PRESENCE_TIMEOUT=6.0

# USB attack demo payload configuration
USB_DEMO_MAX_ATTEMPTS=6
USB_DEMO_INTERVAL=3

# ------------------------------------------------------------------------------
# System Paths
# ------------------------------------------------------------------------------
PROJECT_DIR=
VENV_PATH=

# ------------------------------------------------------------------------------
# Security / Isolation Configuration
# ------------------------------------------------------------------------------
ISOLATION_ENABLED=true
SAFE_STATE=MOTORS_STOPPED
UNSAFE_STATE=INTRUSION_DETECTED

# Service check intervals
SERVICE_CHECK_INTERVAL=5.0
STATUS_LOG_INTERVAL=10.0
HTTP_PRESENCE_WINDOW=4.0

# Node timeout (seconds without heartbeat -> offline)
NODE_TIMEOUT=2.0

# Motor failsafe (stop if no command received)
MOTOR_CMD_FAILSAFE_MS=500
MOTOR_HEARTBEAT_MS=500
MOTOR_STATUS_MS=200
MOTOR_RESEND_INTERVAL=0.2

# ------------------------------------------------------------------------------
# Training Configuration
# ------------------------------------------------------------------------------
TRAINING_DATA_DIR=data/normal
ATTACK_DATA_DIR=data/attack
PROCESSED_DATA_DIR=data/processed
TRAINING_HOURS=2.0
VALIDATION_SPLIT=0.2

# ------------------------------------------------------------------------------
# Advanced Configuration
# ------------------------------------------------------------------------------
# Joystick deadzone
JOYSTICK_DEADZONE=20

# Countdown behavior
ABSENT_TICKS_BEFORE_CANCEL=3
FIX_COOLDOWN=20.0

# Expected CAN rates (Hz) for anomaly detection
# Format: ID:RATE,ID:RATE,...
EXPECTED_CAN_RATES=0x010:2.0,0x011:2.0,0x013:2.0,0x014:2.0,0x100:5.0,0x101:5.0,0x120:10.0,0x121:10.0,0x122:10.0,0x140:1.0,0x141:1.0
