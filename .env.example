# Copy to .env on EACH Pi; never commit .env. Restart the app after changes.
# Use double quotes around values containing spaces or #. No shell sourcing needed.
APP_HOST=0.0.0.0
APP_PORT=5000
# Optional: install requirements-server.txt and select waitress (one process).
APP_SERVER=flask
CAN_CHANNEL=can0
CAN_BACKEND=socketcan
ML_MODEL_PATH=can_ids_model.joblib
USB_STATE_FILE=run/usb_state.json
BLOCK_DELAY=18
REARM_COOLDOWN=5
JOYSTICK_TIMEOUT=0.8

# Management network (SSH, internet, Raspberry Pi Connect). Used by setup_wifi.py home.
HOME_IFACE=wlan0
HOME_SSID="YOUR_HOME_WIFI"
HOME_PASSWORD="REPLACE_ME"

# Separate USB Wi-Fi adapter for the lab AP. Never use HOME_IFACE for the AP.
AP_IFACE=wlan1
AP_IP=10.50.0.1
AP_SSID="Vehicle-IDS-AP"
AP_PASSWORD="REPLACE_WITH_8_TO_63_CHAR_PASSWORD"
WIFI_COUNTRY=IN
# NetworkManager owns the AP in the documented setup. Legacy hostapd recovery stays off.
AUTO_FIX_AP=0
# Set to the designated demo client's real IPv4 on the AP (ipconfig on Windows).
# Do not use the Pi address or the laptop's home-Wi-Fi address here.
ATTACKER_IP=10.50.0.100
ATTACKER_MAC=

# Optional registered USB demo. A serial is required by the generated udev rule.
EXPECTED_VENDOR=
EXPECTED_PRODUCT=
EXPECTED_SERIAL=
ATTACKER_PORT=4444
USB_DEMO_MAX_ATTEMPTS=6
USB_DEMO_INTERVAL=3
